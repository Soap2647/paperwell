{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paperwell",
  "version": "1.0.0",
  "identifier": "dev.paperwell.app",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5173 --strictPort",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Paperwell",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": { "target/bundle-libs/DirectML.dll": "DirectML.dll" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "PDF ve görsel editörü",
    "longDescription": "Paperwell: metni orijinal fontla düzenleyin, akıllı silgi, gerçek karartma, OCR, form doldurma, imza. Tamamen yerel.",
    "fileAssociations": [
      { "ext": ["pdf"], "name": "PDF", "description": "PDF belgesi", "role": "Editor", "mimeType": "application/pdf" },
      { "ext": ["png"], "name": "PNG", "description": "PNG görseli", "role": "Editor", "mimeType": "image/png" },
      { "ext": ["jpg", "jpeg"], "name": "JPEG", "description": "JPEG görseli", "role": "Editor", "mimeType": "image/jpeg" },
      { "ext": ["webp"], "name": "WebP", "description": "WebP görseli", "role": "Editor", "mimeType": "image/webp" },
      { "ext": ["paperwell"], "name": "Paperwell", "description": "Paperwell projesi", "role": "Editor", "mimeType": "application/x-paperwell" }
    ],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Turkish", "English"] }
    }
  }
}
